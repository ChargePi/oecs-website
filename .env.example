# Optional. URL of an OECS Hub instance to link to, baked in at build time.
# Hub links are omitted from the site entirely when this is unset.
VITE_OECS_HUB_URL=https://oecs-hub.chargepi.cc

# Optional. Contact email shown behind a click-to-reveal button in the footer,
# baked in at build time. Omitted from the site entirely when this is unset.
VITE_CONTACT_EMAIL=support@chargepi.cc
